# OpenAI is tried first when configured. Groq is used if OpenAI is unavailable
# or its request fails. If only Groq is configured, it is used directly.
OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_MODEL=gpt-4o-mini
# Optional for OpenAI-compatible endpoints; omit for the standard OpenAI API.
# OPENAI_BASE_URL=https://api.openai.com/v1

GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=replace-with-a-supported-groq-model
